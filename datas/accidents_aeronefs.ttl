:1959-08-14-vickers-815-viscount-id-3674
        rdf:type                 schema:Event;
        ex:aircraftType          "Vickers 815 Viscount";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "17:14";
        ex:operator              "Pakistan International Airlines";
        ex:passengersAboard      "3"^^xsd:int;
        ex:passengersFatalities  "2"^^xsd:int;
        ex:region                "Pakistan";
        dcterms:date             "1959-08-14"^^xsd:date;
        dcterms:description      "The trainee captain attempted a maneuver in disregard of the prescribed limitations of such a maneuver. A two-engine overshoot was attempted at a very low height and below the prescribed minimum speed, when the aircraft was committed to a landing. This resulted in a violent yaw and sharp drop which could not be controlled. The training captain was conversant with the minimum requirements of a two-engine overshoot of the Viscount 815 aircraft but appears to have overestimated his performance.";
        schema:location          "Karachi" .

