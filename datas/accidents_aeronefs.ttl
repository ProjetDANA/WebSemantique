:1973-12-11-douglas-dc-118-id-241
        rdf:type                 schema:Event;
        ex:aircraftType          "Douglas DC-118";
        ex:groundFatalities      "0"^^xsd:int;
        ex:operator              "Military - U.S. Navy";
        ex:passengersAboard      "10"^^xsd:int;
