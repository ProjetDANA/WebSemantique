:1979-03-10-aerospatiale-nord-262a-33-id-907
        rdf:type                 schema:Event;
        ex:aircraftType          "Aerospatiale Nord 262A-33";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "17:52";
        ex:operator              "Swift Aire Lines Inc.";
        ex:passengersAboard      "7"^^xsd:int;
        ex:passengersFatalities  "3"^^xsd:int;
        ex:region                "California";
        ex:route                 "New York - Santa Monica";
        dcterms:date             "1979-03-10"^^xsd:date;
        dcterms:description      "The plane ditched into Santa Monica Bay near Marina del Rey, shortly after taking off from Santa Monica Airport. The flight crew's mismanagement of an emergency procedure following an autofeather of the right-hand propeller which resulted in their shutting down the remaining engine. A leak or break in the propeller pressure line probably caused the right engine to autofeather. The left engine was shut down when the flight crew failed to identify the engine on which the autofeather occurred and moved the left power lever to the stop position. Contributing to the accident was the unavailability of vital restart information to the crew.";
        schema:location          "Off Marina del Rey" .

