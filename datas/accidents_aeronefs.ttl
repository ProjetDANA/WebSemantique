:444    :ABORD       "15"^^xsd:int;
        :CASUALTIES  "15"^^xsd:int;
        :CITY        "NSW";
        :DATE        "1961-11-30"^^xsd:date;
        :GROUND      "0"^^xsd:int;
        :OPERATOR    "Ansett ANA";
        :REGION      "Australia";
        :ROUTE       "Sydney - Canberra";
        :SUMMARY     "Crashed 9 minutes after taking off, into Botan Bay, 3 miles south of the airport . In-flight structural failure due to turbulence.";
