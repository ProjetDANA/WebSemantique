        ex:passengersFatalities  "8"^^xsd:int;
        ex:region                "Sudan";
        dcterms:date             "1983-04-16"^^xsd:date;
        dcterms:description      "The No.2 engine failed during climbout forcing a return to the airport. While on the  base leg the aircraft lost altitude and crashed. High Pressure fuel pump shaft broke due to pump seizure. The remaining engine could not produce enough power because the fuel datum trimmer wasn't reset in accordance with the flight manual.";
        schema:location          "Near Khartoum" .

