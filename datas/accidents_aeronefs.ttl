        ex:region                "Australia";
        dcterms:date             "1956-01-12"^^xsd:date;
        dcterms:description      "Flew into the water upon approach. The pilot relied on inadequate external visual reference for determining the altitude and paid insufficient attention to the instruments. The irregular approach procedure carried out by the pilot in command deprived him of the opportunity to monitor the safe approach to the aerodrome through the correlation of time, height and position.";
        schema:location          "Frederick Henry Bay" .

:1955-12-21-lockheed-749c-79-12-constellation-id-1801
        rdf:type                 schema:Event;
        ex:aircraftType          "Lockheed 749C-79-12 Constellation";
        ex:groundFatalities      "0"^^xsd:int;
