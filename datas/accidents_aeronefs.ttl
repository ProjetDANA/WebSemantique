:1978-12-17-boeing-b-737-2a8-id-2324
        rdf:type                 schema:Event;
        ex:aircraftType          "Boeing B-737-2A8";
        ex:groundFatalities      "3"^^xsd:int;
        ex:operator              "Indian Airlines";
        ex:passengersAboard      "132"^^xsd:int;
        ex:passengersFatalities  "1"^^xsd:int;
        ex:region                "India";
        dcterms:date             "1978-12-17"^^xsd:date;
        dcterms:description      "Couldn't climb on takeoff due to non-availability of leading edge slats, overran the runway and killed one passenger and  3 maintenance workers on the ground cutting grass. Nonavailability of leading edge devices immediately after rotation during take off.";
        schema:location          "Hyderabad" .

:1949-10-28-lockheed-749-79-33-constellation-id-513
        rdf:type                 schema:Event;
        ex:aircraftType          "Lockheed 749-79-33 Constellation";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "02:50";
        ex:operator              "Air France";
        ex:passengersAboard      "48"^^xsd:int;
        ex:passengersFatalities  "48"^^xsd:int;
        ex:region                "Azores";
        ex:route                 "Paris - Santa Maria - New York City";
        dcterms:date             "1949-10-28"^^xsd:date;
        dcterms:description      "While attempting for the third time to land at Santa Maria, the aircraft, flew into Redondo Mountain at 2,950 ft. on San Miguel Island. Crew error. Failure to carry out either of the two approach procedures adopted for Santa Maria airport. False position report give by crew. Inadequate navigation.  Failure to identify Santa Maria airport when flying in VFR conditions. French middleweight boxing champion Marcel Cerdan, 33, and French violinist, Ginette Neveu killed.";
        schema:location          "San Miguel Island" .

