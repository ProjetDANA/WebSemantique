        ex:passengersAboard      "3"^^xsd:int;
        ex:passengersFatalities  "3"^^xsd:int;
        ex:region                "Oregon";
        ex:route                 "Medford, OR - Medford, OR";
        dcterms:date             "1989-08-21"^^xsd:date;
        dcterms:description      "The aircraft emerged out of a fog bank while attempting to land, banked to the left and crashed. The pilot's failure to initiate a go-around after emerging from a fog bank on a short final which resulted in inadequate airspeed and a stall. Contributing to the accident was the pilot's poor judgement in attempting the VFR approach in IMC conditions.";
        schema:location          "Gold Beach" .

:1949-01-05-avro-685-york-1-id-647
