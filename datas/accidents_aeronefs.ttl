        :CASUALTIES  "3"^^xsd:int;
        :CITY        "Quebe";
        :DATE        "1972-12-06"^^xsd:date;
        :GROUND      "0"^^xsd:int;
        :OPERATOR    "Superior Airways";
        :REGION      "Canada";
