:1991-05-26-boeing-b-767-3z9er-id-4578
        rdf:type                 schema:Event;
        ex:aircraftType          "Boeing B-767-3Z9ER";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "23:17";
        ex:operator              "Lauda Air";
        ex:passengersAboard      "223"^^xsd:int;
        ex:passengersFatalities  "223"^^xsd:int;
        ex:region                "Thailand";
        ex:route                 "Bangkok - Wien, Austria";
        dcterms:date             "1991-05-26"^^xsd:date;
        dcterms:description      "Twelve minutes after takeoff the crew received a visual REV ISLN advisory warning which indicated that an additional system failure may cause deployment of the No. 1 engine thrust reverser. No action was taken since the manual indicated 'No Action Required'. Just before reaching FL 310 during a climb, there was an uncommanded deployment of the No. 1 engine thrust reverser. The aircraft stalled, when into a steep high speed dive, broke apart at 4,000 feet and crashed into the jungle 70 miles northwest of Bangkok. Failure of the reverse thrust isolation valve. Following the accident Boeing made modifications to the thrust reverser system. The aircraft was named Wolfgang Amadeus Mozar";
        schema:location          "Near Ban Nong Rong" .

