:2002-05-25-boeing-b-747-209b-id-4475
        rdf:type                 schema:Event;
        ex:aircraftType          "Boeing B-747-209B";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "15:29";
        ex:operator              "China Airlines (Taiwan)";
        ex:passengersAboard      "225"^^xsd:int;
        ex:passengersFatalities  "225"^^xsd:int;
        ex:region                "Taiwan";
        ex:route                 "Taipei - Hong Kong";
        dcterms:date             "2002-05-25"^^xsd:date;
        dcterms:description      "The flight crashed into the sea, 31 miles NE of the Penghu (Pescadore) Islands in the Taiwan Strait. The plane disappeared from radar while flying at 35,000 ft. approximately 20 minutes after taking off from Chiang Kai Shek Airport. There was no distress call and the weather was good at the time. Military radar revealed the aircraft  disintegrated in midair, breaking into four pieces. Only 175 of 225 bodies were recovered. The carrier  failed to conduct a preventive anti-rust operation in a timely manner every four years. Damage from a 1980 tailstrike was not properly repaired and fatigue cracks formed, which eventually led to a structural failure.";
        schema:location          "Off Penghu Island" .

