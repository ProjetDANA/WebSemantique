        ex:operator              "Hallo Bay Air - Air Taxi";
        ex:passengersAboard      "3"^^xsd:int;
        ex:passengersFatalities  "3"^^xsd:int;
        ex:region                "Alaska";
        ex:route                 "Hallo Bay, AK - Homer, AK";
        dcterms:date             "2003-06-25"^^xsd:date;
        dcterms:description      "The airlpane is presumed to have collided with the ocean waters of the Cook Inlet, about 7 miles southwest of Anchor Point, Alaska. No wreckage has been located, and the airplane is presumed to be destroyed. A fatally injured passenger was located on July 3, in ocean waters near Anchor Point. An in-flight collision with water for an undetermined reason.";
        schema:location          "Anchor Point" .

:1994-03-18-grumman-g-73t-turbo-mallard-id-1806
        rdf:type                 schema:Event;
        ex:aircraftType          "Grumman G-73T Turbo Mallard";
        ex:groundFatalities      "0"^^xsd:int;
