:1989-06-07-mcdonnell-douglas-dc-8-super-62-id-4409
        rdf:type                 schema:Event;
        ex:aircraftType          "McDonnell Douglas DC-8 Super 62";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "04:27";
        ex:operator              "Surinam Airways";
        ex:passengersAboard      "187"^^xsd:int;
