<http://example.org/crash/1925-09-03-dirigible-zr-1-shenandoah-(airship)-id-3589>
        rdf:type                 schema:Event;
        ex:aircraftType          "Dirigible ZR-1 Shenandoah (airship)";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "05:30";
        ex:operator              "Military - U.S. Navy";
        ex:passengersAboard      "43"^^xsd:int;
        ex:passengersFatalities  "14"^^xsd:int;
        ex:region                "Ohio";
        ex:route                 "Lakehurst, NJ - S.t Louis, MO";
        dcterms:date             "1925-09-03"^^xsd:date;
        dcterms:description      "The Shenandoah was flying over Southern Ohio when she abruptly encountered violent atmosphericonditions (thunderstorms). Powerful air currents buffeted her so severely that her crew was unable to maintain control. Rising rapidly above her pressure height, then falling and rising again, her hull structure was overstressed amidships, breaking the airship in two. Shenandoah's external control car and two engine cars fell free, carrying the dirigible's commanding officer and several other men to their deaths. The stern section came down nearby, while several men were able to fly the bow section to ground as a free balloon.";
        schema:location          "Caldwell" .

