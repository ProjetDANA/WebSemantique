        rdf:type                 schema:Event;
        ex:aircraftType          "Aerospatiale AS350BA Rotocraft";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "15:00";
        ex:operator              "Heli-USA Airways";
        ex:passengersAboard      "7"^^xsd:int;
        ex:passengersFatalities  "4"^^xsd:int;
        ex:region                "Hawaii";
        ex:route                 "Sightseeing";
        dcterms:date             "2007-03-08"^^xsd:date;
        dcterms:description      "The helicopter crashed on Kauai shortly after the pilot radioed that he was having problems with the hydraulics. The helicopter hit the ground about 200 yards from it's normal landing pad. The failure of maintenance personnel to properly tighten (torque) the flight control servo lower attachment clevis, and reinstall a functioning lock washer, which resulted in a flight control disconnect and a complete loss of helicopter control. Contributing to the accident was the operator's failure to ensure its maintenance program was being executed in accordance with Federal regulations.";
        schema:location          "Princeville" .

