:1988-05-24-boeing-b-737-3t0-id-2855
        rdf:type                 schema:Event;
        ex:aircraftType          "Boeing B-737-3T0";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "12:55";
        ex:operator              "TACA";
        ex:passengersAboard      "45"^^xsd:int;
        ex:passengersFatalities  "0"^^xsd:int;
        ex:region                "Louisiana";
        ex:route                 "Belize City, Belize - New Orleans, LA";
        dcterms:date             "1988-05-24"^^xsd:date;
        dcterms:description      "The aircraft encountered heavy rain and hail which resulted in flame-out of both engines. Attempts to restart engines were unsuccessful. The aircraft landed safely in a grassy field between a drainage ditch and levee with no power. Water ingestion due to heavy rain from a level 4 thunderstorm caused failure of both engines. A contributing cause of the incident was the inadequate design of the engines and the FAA water ingestion certification standards which did not reflect the waterfall rates that can be expected in moderate or higher intensity thunderstorms.";
        schema:location          "New Orleans" .

