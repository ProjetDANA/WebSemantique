        ex:region                "Oregon";
        ex:route                 "Eugene - Portland";
        dcterms:date             "1966-10-01"^^xsd:date;
        dcterms:description      "The plane crashed into Salmon Mountain while on approach to Portland. The pilots evidently had agreed to maintain 9,000 feet, but descended instead. The aircraft hit the mountain at the 3,830-foot level of a 4,090-foot ridge. The crew's descent  below its clearance limit and below that of surrounding obstructing terrain for reasons unknown. First crash of a DC-9.";
        schema:location          "Near Wemme" .

:1990-11-14-mcdonnell-douglas-dc-9-32-id-4437
        rdf:type                 schema:Event;
