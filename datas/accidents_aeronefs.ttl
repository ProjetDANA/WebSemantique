:2008-11-27-airbus-a320-232-id-1925
        rdf:type                 schema:Event;
        ex:aircraftType          "Airbus A320-232";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "17:00";
        ex:operator              "XL Airways leased from Air New Zealand";
        ex:passengersAboard      "7"^^xsd:int;
        ex:passengersFatalities  "7"^^xsd:int;
        ex:region                "France";
        ex:route                 "Training";
        dcterms:date             "2008-11-27"^^xsd:date;
        dcterms:description      "The Airbus A320 was leased by XL Airways of Germany since May 2006. The plane was scheduled to be returned to its owner, Air New Zealand. The plane was ferried to Perpignan, France where it underwent maintenance at EAS Industries. During a second test flight, on approach to Perpignan, at 3,500 feet, radio contact was lost. A controller reported seeing the plane descending quickly in a left bank. The aircraft soon after crashed into the sea and broke up.";
        schema:location          "Off Perpignan" .

:1978-03-07-cessna-310i-id-3091
        rdf:type                 schema:Event;
