        ex:passengersAboard      "3"^^xsd:int;
        ex:passengersFatalities  "3"^^xsd:int;
        ex:region                "Mexico";
        dcterms:date             "1957-04-15"^^xsd:date;
        dcterms:description      "The accident was due to a maneuvering error which consisted in making two turns onto the Mexico City heading without conforming the distance and procedure specifications and below the prescribed altitudes and speeds. This error was aggravated by a probable shifting of the load due to improper securing.";
        schema:location          "Merida" .

