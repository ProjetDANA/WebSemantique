:1964-11-23-boeing-b-707-331-id-2646
        rdf:type                 schema:Event;
        ex:aircraftType          "Boeing B-707-331";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "13:09";
        ex:operator              "Trans World Airlines";
        ex:passengersAboard      "73"^^xsd:int;
