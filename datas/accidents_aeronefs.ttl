:1998-01-09-cessna-208b-caravan-i-id-3522
        rdf:type                 schema:Event;
        ex:aircraftType          "Cessna 208B Caravan I";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "17:04";
        ex:operator              "Mountain Air Cargo";
        ex:passengersAboard      "1"^^xsd:int;
