:1996-09-25-douglas-dc-3c-id-3241
        rdf:type                 schema:Event;
        ex:aircraftType          "Douglas DC-3C";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "16:37";
        ex:operator              "Dutch Dakota Association";
        ex:passengersAboard      "32"^^xsd:int;
        ex:passengersFatalities  "32"^^xsd:int;
        ex:region                "Netherlands";
        ex:route                 "Texel - Amsterdam";
        dcterms:date             "1996-09-25"^^xsd:date;
        dcterms:description      "Shortly after takeoff from Texel, a connecting rod bearing in the No.1 engine failed. The prop was feathered.  Soon after, a part of the feathering mechanism failed and the prop started windmilling causing drag. The aircraft rapidly descended and crashed onto a mud-flat. The accident was initiated by a combined failure of the left engine and the left feathering system. The accident became inevitable when the flight crew allowed the speed to decrease below stall speed and lost control of the aircraft at an altitude from which recovery was not possible.";
        schema:location          "Waddenzee" .

