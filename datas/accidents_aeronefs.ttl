:3055   :ABORD       "10"^^xsd:int;
        :CASUALTIES  "10"^^xsd:int;
        :CITY        "Marine City";
        :DATE        "1999-07-31"^^xsd:date;
        :GROUND      "0"^^xsd:int;
        :HOUR        "08:30";
        :OPERATOR    "Private";
        :REGION      "Michigan";
        :ROUTE       "Sky Diving";
        :SUMMARY     "The aircraft, which was carrying members of a skydiving club, crashed shortly after taking off from Marine City Airport. Witnesses reported the plane banked hard to the right and flew into the ground. The aircraft was destroyed by fire. The pilot's failure to maintain adequate airspeed, which resulted in a stall, inflight loss of control and collision with the ground.";
        :TYPE        "Beech King Air 65-A90".

:841    :ABORD       "5"^^xsd:int;
        :CASUALTIES  "5"^^xsd:int;
        :CITY        "Burbank";
        :DATE        "1962-12-14"^^xsd:date;
        :GROUND      "3"^^xsd:int;
        :HOUR        "22:12";
        :OPERATOR    "Flying Tiger Line";
        :REGION      "California";
        :ROUTE       "Chicago - Burbank";
        :SUMMARY     "The aircraft crashed during an ILS approach to Burbank Airport. Incapacitation of the captain with a heart attack at a critical point in the approach from which the co-pilot could not recover.";
        :TYPE        "Lockheed 1049H Super Constellation".

:4149   :ABORD       "12"^^xsd:int;
        :CASUALTIES  "12"^^xsd:int;
        :CITY        "Kigali";
        :DATE        "1994-04-06"^^xsd:date;
