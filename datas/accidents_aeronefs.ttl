:1974-01-30-boeing-b-707-321b-id-283
        rdf:type                 schema:Event;
        ex:aircraftType          "Boeing B-707-321B";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "23:41";
        ex:operator              "Pan American World Airways";
