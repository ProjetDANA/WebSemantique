        ex:route                 "Warsaw - Miroslawiec";
        dcterms:date             "2008-01-23"^^xsd:date;
        dcterms:description      "While attempting to land, the plane fell to the ground from about 500-650 feet and crashed into a wooded area, 2 miles from the airport.";
        schema:location          "Miroslawiec" .

:1975-07-10-lockheed-l-188af-electra-id-1271
