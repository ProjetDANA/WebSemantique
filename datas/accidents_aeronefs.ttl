:1972-03-03-fairchild-hiller-fh-227-b-id-3379
        rdf:type                 schema:Event;
        ex:aircraftType          "Fairchild-Hiller FH-227-B";
        ex:groundFatalities      "1"^^xsd:int;
        ex:hour                  "20:48";
        ex:operator              "Mohawk Airlines";
        ex:passengersAboard      "48"^^xsd:int;
        ex:passengersFatalities  "16"^^xsd:int;
        ex:region                "New York";
        ex:route                 "New York City - Albany, NY";
        dcterms:date             "1972-03-03"^^xsd:date;
        dcterms:description      "The aircraft was on final approach to Albany County Airport in light snow and two miles visibility, when the pilot reported a malfunctioning left propeller cruise pitch lock. The captain ordered the engine shut down but the crew was unsuccessful in feathering the prop and the plane began to lose altitude. The plane crashed 4 miles short of the runway into a two-family house killing one man. Malfunction of the cruise pitch lock.  Inability of the crew to feather the left propeller, in combination with the descent below the minimum approach altitude. The reason for the malfunction and inability to feather the prop remains undetermined.";
        schema:location          "Albany" .

