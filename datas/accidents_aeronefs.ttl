:1999-02-24-tupolev-tu-154-id-1236
        rdf:type                 schema:Event;
        ex:aircraftType          "Tupolev TU-154";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "16:34";
        ex:operator              "China Southwest Airlines";
        ex:passengersAboard      "61"^^xsd:int;
