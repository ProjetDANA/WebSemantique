        dcterms:description      "The plane went into a dive and crashed 6 km short of the runway into a swamp during a second attempt at landing. Loss of power in the No. 1 engine.";
        schema:location          "Near Douala" .

:2007-03-11-mdonnell-douglas-369ff-rotocraft-id-2164
        rdf:type                 schema:Event;
        ex:aircraftType          "MDonnell Douglas 369FF Rotocraft";
        ex:groundFatalities      "0"^^xsd:int;
