:1959-10-26-douglas-c-47a-dl-id-953
        rdf:type                 schema:Event;
        ex:aircraftType          "Douglas C-47A-DL";
        ex:groundFatalities      "1"^^xsd:int;
        ex:hour                  "20:18";
        ex:operator              "PacifiAir Lines";
        ex:passengersAboard      "19"^^xsd:int;
        ex:passengersFatalities  "1"^^xsd:int;
        ex:region                "California";
        ex:route                 "Los Angeles - Oxnard - Santa Maria - Paso Robles";
        dcterms:date             "1959-10-26"^^xsd:date;
        dcterms:description      "Moments after rotation the left engine exploded and caught fire. The elevator of the plane hit a 12,000 volt powerline and crash landed upright sliding 65 feet. The only fatality was the first officer who was thrown clear of the accident still strapped to his seat. The number 5 cylinder of the left engine failed leading to an explosion that deformed the left engine's ring cowl to a degree that cause excessive drag and buffeting that made sustained flight impossible. Maintenance records showed the engine had a troubling number of oil leaks.";
        schema:location          "Santa Maria" .

