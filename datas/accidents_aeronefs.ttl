:1980-07-21-cessna-404-titan-ii-id-407
        rdf:type                 schema:Event;
        ex:aircraftType          "Cessna 404 Titan II";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "17:02";
        ex:operator              "SceniAirlines";
        ex:passengersAboard      "8"^^xsd:int;
