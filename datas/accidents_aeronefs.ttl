:1964-02-25-mcdonnell-douglas-dc-8-21-id-2837
        rdf:type                 schema:Event;
        ex:aircraftType          "McDonnell Douglas DC-8-21";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "02:06";
        ex:operator              "Eastern Air Lines";
