:1945-09-07-douglas-dc-3-id-4235
        rdf:type                 schema:Event;
        ex:aircraftType          "Douglas DC-3";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "02:13";
        ex:operator              "Eastern Air Lines";
        ex:passengersAboard      "22"^^xsd:int;
