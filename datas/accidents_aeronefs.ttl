        ex:region                "Alaska";
        ex:route                 "Sightseeing";
        dcterms:date             "2007-07-24"^^xsd:date;
        dcterms:description      "The single engine aircraft crashed onto a heavily forested mountain, 30 miles east of Ketchican while on a sightseeing trip over Misty Fiords. The pilot's decision to continue under visual flight rules into an area of instrument meteorological conditions. Contributing to the accident was the pilot's inadequate weather evaluation and the FAA's inadequate surveillance of the commercial air tour operator.";
        schema:location          "Rudyerd Bay" .

:1998-03-05-cessna-208b-caravan-i-super-cargomaster-id-4500
        rdf:type                 schema:Event;
