:4657   :ABORD       "3"^^xsd:int;
        :CASUALTIES  "3"^^xsd:int;
        :CITY        "Griesta";
        :DATE        "1996-05-19"^^xsd:date;
        :GROUND      "0"^^xsd:int;
        :HOUR        "23:36";
        :OPERATOR    "Loganair";
        :REGION      "United Kingdom";
