:1997-12-17-yakovlev-yak-42-id-2107
        rdf:type                 schema:Event;
        ex:aircraftType          "Yakovlev YAK-42";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "21:13";
        ex:operator              "Aerosweet Airlines (LVOV)";
        ex:passengersAboard      "70"^^xsd:int;
        ex:passengersFatalities  "70"^^xsd:int;
        ex:region                "Greece";
        ex:route                 "Odessa - Thessaloniki";
        dcterms:date             "1997-12-17"^^xsd:date;
        dcterms:description      "The aircraft crashed into Mt. Olympus while approaching Salonica, during a second attempt to land. The plane was holding at 3,300 feet due to heavy traffic. Tower tapes indicate that after the missed approach, the crew reported they were heading north when they actually were heading west. An investigation revealed the crew had poor training, flew too low, didn't know how to use the radar equipment and failed to declare an emergency after they missed the landing strip. A second crash occurred when a C-130 transport plane on its way to pick up troops to assist in the search, crashed into Pastra Mountain.";
        schema:location          "Fotina" .

