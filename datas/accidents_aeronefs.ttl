<http://example.org/crash/1995-09-22-boeing-b-707-(e-3b)-id-109>
        rdf:type                 schema:Event;
        ex:aircraftType          "Boeing B-707 (E-3B)";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "07:45";
        ex:operator              "Military - U.S. Air Force";
        ex:passengersAboard      "24"^^xsd:int;
        ex:passengersFatalities  "24"^^xsd:int;
        ex:region                "Alaska";
        ex:route                 "Anchorage-Elmendorf AFB - Anchorage-Elmendorf AFB";
        dcterms:date             "1995-09-22"^^xsd:date;
        dcterms:description      "The aircraft suffered multiple bird strikes in the No. 1 and 2 engines just after taking off when it flew into a flock of 100 or more Canada Geese. The crew initiated a slow climb and began to dump fuel. The aircraft attained a maximum altitude of 250 ft. before it started to descend. The plane impacted a hilly wooded area less than a mile from the runway, broke up, exploded and burned.  Ingestion of Canada geese into the Nos.1 and 2 engines. Lack of adequate procedures to reduce bird hazards. The crew was not warned about observations of birds in the area by the ATC.";
        schema:location          "Anchorage" .

