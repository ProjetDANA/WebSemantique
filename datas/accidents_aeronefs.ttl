:854    :ABORD       "32"^^xsd:int;
        :CASUALTIES  "32"^^xsd:int;
        :CITY        "Diablo Mts.";
        :DATE        "1948-01-28"^^xsd:date;
        :GROUND      "0"^^xsd:int;
        :HOUR        "10:50";
        :OPERATOR    "Airline Transport Carriers";
        :REGION      "California";
        :ROUTE       "Burbank - Oakland";
        :SUMMARY     "The crew took the wrong plane which was scheduled for maintenance.  An in-flight fire caused the engine and then wing to separate from the aircraft and crash out of control. Tests showed a fuel pump was broken in the left engine and would spray gasoline out where it could be ignited by the exhaust. The failure of the left wing in flight as a result of damage by fire which had its source in a defective left engine driven fuel pump.";
        :TYPE        "Douglas DC-3 (C-47B-DK)".

:2164   :ABORD       "5"^^xsd:int;
