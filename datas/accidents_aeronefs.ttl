:1982-01-23-mcdonnell-douglas-dc-10-30cf-id-2929
        rdf:type                 schema:Event;
        ex:aircraftType          "McDonnell Douglas DC-10-30CF";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "19:36";
        ex:operator              "World Airways";
        ex:passengersAboard      "212"^^xsd:int;
        ex:passengersFatalities  "2"^^xsd:int;
        ex:region                "Massachusett";
        ex:route                 "Newark, NJ - Boston, MA";
        dcterms:date             "1982-01-23"^^xsd:date;
        dcterms:description      "While landing on an icy runway, the aircraft touched down 2,800 feet beyond the displaced threshold and slid off the end of the runway into shallow water with the nose section detaching. The minimal braking effectiveness on the ice-covered runway. The crew landed without sufficient information as to runway conditions. Lack of FAA regulations. The pilot's decision to retain autothrottle speed control throughout the flare and the consequent extended touchdown point on the runway contributed to the severity of the accident.";
        schema:location          "Boston" .

