:1994-07-14-aerospatiale-as350d-id-2170
        rdf:type                 schema:Event;
        ex:aircraftType          "Aerospatiale AS350D";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "15:36";
        ex:operator              "Air Taxi - Papillion Helicopters Ltd.";
