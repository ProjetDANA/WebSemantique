        ex:region                "Spain";
        ex:route                 "Madrid - Bilbao";
        dcterms:date             "1985-02-19"^^xsd:date;
        dcterms:description      "The aircraft crashed into an antenna on Mt. Oiz. Incorrect interpretation of Ground Proximity Warning System. The captain was heard shouting 'shut up' at the GPWS as it announced 'pull up.'  Overconfidence in altitude alert system. Incorrect interpretation of its warnings.";
        schema:location          "Vizcaya" .

:2009-02-07-bandeirante-emb-110p1-id-680
        rdf:type                 schema:Event;
        ex:aircraftType          "Bandeirante EMB-110P1";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "14:00";
        ex:operator              "Aerotaxi Manaus";
        ex:passengersAboard      "28"^^xsd:int;
        ex:passengersFatalities  "24"^^xsd:int;
        ex:region                "Brazil";
        ex:route                 "Coari - Manus";
        dcterms:date             "2009-02-07"^^xsd:date;
        dcterms:description      "The plane was being used as an air taxi to ferry passengers between cities when it crashed in the Manacapuru River, 50 miles from Manus. The plane took off under warning of strong winds and rain. The crew asked permission to return shortly after takeoff because they lost an engine. The plane disappeared from radar and lost contact with ATC. The plane crashed into the river when the crew tried to land the plane on an abandoned runway in the town of Manacapuru.";
        schema:location          "Manacapuru" .

