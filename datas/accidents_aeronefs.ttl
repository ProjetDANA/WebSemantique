        ex:passengersAboard      "128"^^xsd:int;
        ex:passengersFatalities  "1"^^xsd:int;
        ex:region                "New Mexico";
        ex:route                 "Miami, FL - San Francisco, CA";
        dcterms:date             "1973-11-03"^^xsd:date;
        dcterms:description      "Overspeeding of the starboard engine caused the engine to disintegrate. Pieces struck the fuselage, breaking a window, causing rapid explosive decompression and a passenger was sucked out of the plane.  The plane landed safely. The captain and flight engineer were experimenting with the autothrottle system by tripping the circuit breakers which supplied the instruments which measured the rotational speed of each engine's low pressure compressor. This led to engine overspeeding and destruction of the engine.";
        schema:location          "Near Albuquerque" .

