        ex:operator              "Northern Illinois Flight Center";
        ex:passengersAboard      "6"^^xsd:int;
        ex:passengersFatalities  "2"^^xsd:int;
        ex:region                "Minnesota";
        ex:route                 "Chicago - Beaver Island";
        dcterms:date             "2001-02-08"^^xsd:date;
        dcterms:description      "Impacted trees and crashed while attempting to land. The flightcrew not maintaining altitude/clearance during the circling instrument approach. Factors were the pilot in command initiating the flight without proper weather reporting facilities at the destination, the flightcrew not flying to an alternate destination, the flightcrew not following company and FAA procedures/directives, the lack of certification of the second pilot, the operator not following company and FAA procedures/directives, and the dark night and the low ceiling.";
        schema:location          "Beaver Island" .

