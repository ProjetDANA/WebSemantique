:3440   :ABORD       "6"^^xsd:int;
        :CASUALTIES  "5"^^xsd:int;
        :CITY        "Near Blenheim";
        :DATE        "1996-01-29"^^xsd:date;
        :GROUND      "0"^^xsd:int;
        :HOUR        "16:26";
        :OPERATOR    "Soundsair";
        :REGION      "New Zealand";
        :ROUTE       "Wellington - Picton";
        :SUMMARY     "The aircraft crashed into Mt. Robertson at 1, 400 ft. after entering a layer of clouds on its eastern slope. Descent  by the pilot into a cloud layer at high speed with insufficient forward visibility. Descent under a cloud layer; misidentification of terrain features; loss of 'positional awareness'; insufficient forward visibility; the high speed of the aircraft; and the pilot's decision making.";
        :TYPE        "Cessna 208 Caravan I".

:986    :ABORD       "3"^^xsd:int;
        :CASUALTIES  "2"^^xsd:int;
