        schema:location          "Kumarapura" .

:1998-08-04-de-havilland-dash-2-beaver-id-1013
        rdf:type                 schema:Event;
        ex:aircraftType          "de Havilland Dash-2 Beaver";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "17:58";
        ex:operator              "Harbour Air Seaplanes Ltd.";
        ex:passengersAboard      "5"^^xsd:int;
        ex:passengersFatalities  "5"^^xsd:int;
        ex:region                "Canada";
        ex:route                 "Prince Rupert - Kincolith";
        dcterms:date             "1998-08-04"^^xsd:date;
        dcterms:description      "The pilot made three low passes over the water in an attempt to land at Kincolith. On the fourth approach, the aircraft touched down, apparently in a controlled manner, and skipped on the water surface. The floats then dug into the water followed by the right wing, which was severed from the fuselage on water impact. The aircraft quickly overturned and came to rest inverted with only the bottom of the floats visible. All five occupants drowned. On touchdown, the floats struck the water and caused a flying attitude that the pilot could not control before the right wing dug in and the aircraft overturned. Contributing to the accident were conflicting wind and water conditions at the time of the occurrence.";
        schema:location          "British Columbia" .

