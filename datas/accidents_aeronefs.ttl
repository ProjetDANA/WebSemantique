:1946-04-05-vickers-wellington-bomber-id-2899
        rdf:type                 schema:Event;
        ex:aircraftType          "Vickers Wellington bomber";
        ex:groundFatalities      "16"^^xsd:int;
        ex:hour                  "11:15";
        ex:operator              "Military - Royal British Navy";
        ex:passengersAboard      "4"^^xsd:int;
        ex:passengersFatalities  "4"^^xsd:int;
        ex:region                "Malta";
        dcterms:date             "1946-04-05"^^xsd:date;
        dcterms:description      "The Wellington was engaged in exercises with a Spitfire fighter. The fighter was using the Wellington as a dummy target and the Wellington was to take evasive action. When the bomber was between 4,000 and 5,000 feet altitude, it turned to port and started diving at 20 degrees. It kept on loosing altitude till it crashed into houses in the center of Rabat. No distress signal was transmitted to either the fighter pilot or ground control.  The probable cause of the accident was leakage of hydraulifluid which somehow heated and released fumes in the cockpit rendering the crew unconcious.";
        schema:location          "Rabat" .

