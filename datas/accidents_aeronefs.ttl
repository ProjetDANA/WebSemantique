        schema:location          "Off Nuka Hiva" .

:1937-07-02-lockheed-10e-electra-id-3284
        rdf:type                 schema:Event;
        ex:aircraftType          "Lockheed 10E Electra";
        ex:groundFatalities      "0"^^xsd:int;
        ex:operator              "Private - Purdue Reasearch Foundation";
        ex:passengersAboard      "2"^^xsd:int;
