:1999-01-13-douglas-dc-3c-id-1017
        rdf:type                 schema:Event;
        ex:aircraftType          "Douglas DC-3C";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "06:33";
        ex:operator              "Kelowna Flightcraft Air Charter";
        ex:passengersAboard      "2"^^xsd:int;
        ex:passengersFatalities  "2"^^xsd:int;
        ex:region                "Canada";
        ex:route                 "Vancouver - Victoria";
        dcterms:date             "1999-01-13"^^xsd:date;
        dcterms:description      "Shortly after taking off, the cargo plane began to lose altitude until it hit trees, went off a cliff and crashed to a valley floor. The accident flight was not conducted in accordance with the night obstacle clearance requirements of Canadian Aviation Regulation. The Kelowna Flightcraft company operations manual did not reflect the restrictive conditions imposed on night visual flight rules (VFR) flight by CAR 705.32. Such information might have prevented the accident by ensuring the crew's awareness of those night obstacle clearance standards.";
        schema:location          "British Columbia" .

