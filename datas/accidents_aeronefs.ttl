        ex:operator              "North Central Airlines / Air Wisconsin";
        ex:passengersAboard      "13"^^xsd:int;
        ex:passengersFatalities  "13"^^xsd:int;
        ex:region                "Wisconsin";
        ex:route                 "Chicago, IL - Appleton, WI - Sheboygan, WI";
        dcterms:date             "1972-06-29"^^xsd:date;
        dcterms:description      "Both aircraft were proceeding under VFR getting ready to land when there was a midair collision. Both aircraft crashed into Lake Winnebago and sank. The failure of both flightcrews to detect visually the other aircraft in sufficient time to initiate evasive action.";
        schema:location          "Appleton" .

