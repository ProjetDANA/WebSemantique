        ex:region                "Belgian Congo";
        dcterms:date             "1952-02-04"^^xsd:date;
        dcterms:description      "In-flight failure of a propeller which damaged control cables causing loss of control of the aircraft. The control cables in the fuselage were sheared by the right propeller which broke loose following a shaft failure caused by the sudden stopping of the engine caused by fatigue failure of No. 6 piston lug.";
        schema:location          "Kikwit" .

