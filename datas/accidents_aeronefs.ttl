:1996-07-20-douglas-dc-6a-id-234
        rdf:type                 schema:Event;
        ex:aircraftType          "Douglas DC-6A";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "15:15";
        ex:operator              "Northern Air Cargo";
        ex:passengersAboard      "4"^^xsd:int;
        ex:passengersFatalities  "4"^^xsd:int;
        ex:region                "Alaska";
        ex:route                 "Emmonak - Aniak";
        dcterms:date             "1996-07-20"^^xsd:date;
        dcterms:description      "Soon after takeoff, the No. 3 engine caught fire in the cargo plane. The pilot tried to return to the airport for an emergency landing but the right wing seperated and the plane crashed. Fatigue failure of the master connecting rod, which originated from corrosion pitting, subsequently compromised the engine crankcase, and resulted in a fire; and failure of the flight crew to follow emergency procedures by pulling the fire handle before feathering the propeller, which diminished the effectiveness of the fire suppression system.";
        schema:location          "Russian Mission" .

