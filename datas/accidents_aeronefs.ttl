:2151   :ABORD       "10"^^xsd:int;
        :CASUALTIES  "2"^^xsd:int;
        :CITY        "Les Prevosts";
        :DATE        "1961-11-01"^^xsd:date;
        :GROUND      "0"^^xsd:int;
