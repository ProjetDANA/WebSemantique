        :HOUR        "02:00";
        :OPERATOR    "Boeing Aircraft Company";
        :REGION      "Utah";
        :ROUTE       "Salt Lake City - Cheyenne";
        :SUMMARY     "Crashed on top of Parley's canyon, 20 miles from Salt Lake City shortly after taking off for Cheyenne.";
        :TYPE        "Boeing 247".

:1594   :ABORD       "11"^^xsd:int;
