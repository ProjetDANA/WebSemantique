:1972-01-26-mcdonnell-douglas-dc-9-32-id-1514
        rdf:type                 schema:Event;
        ex:aircraftType          "McDonnell Douglas DC-9-32";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "16:10";
        ex:operator              "JAT Yugoslav Airlines";
        ex:passengersAboard      "28"^^xsd:int;
        ex:passengersFatalities  "27"^^xsd:int;
        ex:region                "Czechoslovakia";
        ex:route                 "Stockholm - Belgrade";
        dcterms:date             "1972-01-26"^^xsd:date;
        dcterms:description      "The plane crashed after the detonation of a bomb in the forward cargo hold. A flight attendant,  22 year old Vesna Vulovic, fell 33,330 feet in the tail section and although she broke both legs and was temporarily paralyzed from the waist down, she survived. She was in a coma for 27 days and it took 16 months for her to recover. The bomb was believed to be placed on the plane by a Croatian extremist group. On January 27, 1997, 25 years after the crash, Vesna Vulovireturned to the crash-site and was reunited with the firemen who pulled her from the wreckage and the medical team who looked after her in the hospital.";
        schema:location          "Near Hermsdorf" .

