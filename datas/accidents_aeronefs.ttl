:1977-03-27-boeing-b-747-121---boeing-b-747-206b-id-1131
        rdf:type                 schema:Event;
        ex:aircraftType          "Boeing B-747-121 / Boeing B-747-206B";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "17:07";
        ex:operator              "Pan American World Airways / KLM";
        ex:passengersAboard      "644"^^xsd:int;
        ex:passengersFatalities  "583"^^xsd:int;
        ex:region                "Canary Islands";
        ex:route                 "Tenerife - Las Palmas / Tenerife - Las Palmas";
        dcterms:date             "1977-03-27"^^xsd:date;
        dcterms:description      "Both aircraft were diverted to Tenerife because of a bombing at Las Palmas Airport. After an extended delay,  both planes were instructed to back track up the runway. The KLM plane reached its takeoff point while the Pan Am plane was still on the runway. The Pan Am plane continued up the runway missing the taxiway turnout. There was heavy fog on the runway. The KLM plane began its takeoff roll without permission with the Pan Am plane still on the runway. The KLM plane hit the Pan Am plane just as it was taking off. Both planes burst into flames.  KLM 234 + 14 crew,  Pan Am 326 + 9 crew killed. All aboard the KLM plane were killed. The Pan Am aircraft was named Clipper Victor. The KLM aircraft was named Rhine River.";
        schema:location          "Tenerife" .

