:1997-09-13-tupolev-tu-154m---c-141-starlifter-id-68
        rdf:type                 schema:Event;
        ex:aircraftType          "Tupolev TU-154M / C-141 Starlifter";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "17:10";
        ex:operator              "Military - Luftwaffe / Military - USAF";
        ex:passengersAboard      "33"^^xsd:int;
        ex:passengersFatalities  "33"^^xsd:int;
        ex:region                "Africa";
        dcterms:date             "1997-09-13"^^xsd:date;
        dcterms:description      "Midair collision at 39,000 ft. The Tupolev 154 aircraft was flying at the wrong cruise altitude which caused the midair collision. Twenty-four killed aboard the Tupolev and 9 aboard the C-141. Contributing factors included weak flight-following procedures of the Luanda ATC and  poor regional ground communications.";
        schema:location          "Off Namibia" .

:2007-06-04-cessna-550-citation-ii-id-4973
        rdf:type                 schema:Event;
        ex:aircraftType          "Cessna 550 Citation II";
        ex:groundFatalities      "0"^^xsd:int;
        ex:hour                  "16:04";
        ex:operator              "University of Michigan Health System";
        ex:passengersAboard      "6"^^xsd:int;
        ex:passengersFatalities  "6"^^xsd:int;
        ex:region                "Wisconson";
        ex:route                 "Milwaukee, WI - Detroit, MI";
        dcterms:date             "2007-06-04"^^xsd:date;
        dcterms:description      "The pilot issued a distress signal within five minutes of taking off from General Mitchell International Airport in Milwaukee, requesting an emergency return to the airport. The plane then crashed into Lake Michigan two miles off shore. The plane was carrying an organ transplant team. The pilot reported to ATC he had runaway trim prior to the accident.";
        schema:location          "Near Milwaukee" .

