PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX schema: <http://schema.org/>
PREFIX dbo:    <http://dbpedia.org/ontology/>
PREFIX geo:    <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX ex:     <http://example.org/disaster/>

# commande : tarql-1.2/bin/tarql queries/tarql.sparql > datas/disasters.ttl

# identifier une catastrophe
CONSTRUCT {
    ?disasterURI a dbo:Disaster, schema:Event ;
                 rdfs:label ?event_name ;

                 dbo:type ?disaster_type ;
                 schema:category ?disaster_group ;
                 ex:disasterSubtype ?disaster_subtype ;
                 ex:disasterSubgroup ?disaster_subgroup ;

                 dbo:year ?year ;
                 dbo:month ?start_month ;

                 dbo:region ?region ;
                 dbo:country ?country ;
                 dbo:continent ?continent ;
                 dbo:isoCode ?iso ;
                 geo:lat ?latitude ;
                 geo:long ?longitude ;

                 dbo:damage ?total_damage ;
                 dbo:deathToll ?total_death ;
                 ex:totalAffected ?total_affected .
}
FROM <file:../datas/1900_2021_DISASTERS.csv> 

# typage des vrais colonnes de notre catastrophe
WHERE {
    # évite les doublons, code unique
    BIND(IRI(CONCAT("http://example.org/disaster/", STR(?Year), "-", ENCODE_FOR_URI(LCASE(STR(?Country))), "-", ENCODE_FOR_URI(LCASE(STR(?Disaster_Type))), "-", STR(?Seq))) AS ?disasterURI)

    # typages
    BIND(STRLANG(?Event_Name, "en") AS ?event_name)

    BIND(STRLANG(?Disaster_Type, "en") AS ?disaster_type)
    BIND(STRLANG(?Disaster_Group, "en") AS ?disaster_group)
    BIND(STRLANG(?Disaster_Subtype, "en") AS ?disaster_subtype)
    BIND(STRLANG(?Disaster_Subgroup, "en") AS ?disaster_subgroup)

    BIND(STRDT(?Year, xsd:integer) AS ?year)
    # float dans csv mais int en vrai (12.0 = 12 = decembre)
    BIND(xsd:integer(xsd:decimal(?Start_Month)) AS ?start_month)

    BIND(STRLANG(?Region, "en") AS ?region)
    BIND(STRLANG(?Country, "en") AS ?country)
    BIND(STRLANG(?Continent, "en") AS ?continent)
    BIND(STR(?ISO) AS ?iso)
    BIND(STRDT(?Latitude, xsd:float) AS ?latitude)
    BIND(STRDT(?Longitude, xsd:float) AS ?longitude)

    BIND((xsd:decimal(?Total_Damages_USD) * 1000) AS ?total_damage)
    # float dans csv mais int en vrai
    BIND(xsd:integer(xsd:decimal(?Total_Deaths)) AS ?total_death)
    BIND(xsd:integer(xsd:decimal(?Total_Affected)) AS ?total_affected)
}


# Requête
# Quels sont les pays les plus touchés par les séismes entre 2000 et 2020 avec plus de 1000 morts ?

PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?pays (COUNT(DISTINCT ?seisme) AS ?nb_seismes)
WHERE {
    ?seisme dbo:type "Earthquake"@en ;
            dbo:country ?pays ;
            dbo:deathToll ?nb_mort ;
            dbo:year ?year.

    FILTER (?nb_mort > 1000)
    FILTER (
        ?year >= 2000 &&
        ?year <= 2020
    )
}
GROUP BY ?pays
ORDER BY DESC(?nb_seismes)
