# Requête
# Quels sont les pays les plus touchés par les séismes entre 2000 et 2020 avec plus de 1000 morts ?

PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?pays (COUNT(DISTINCT ?seisme) AS ?nb_seismes)
WHERE {
    ?seisme dbo:type "Earthquake"@en ;
            dbo:country ?pays ;
            dbo:deathToll ?nb_mort ;
            dbo:year ?year.

    FILTER (?nb_mort > 1000)
    FILTER (
        ?year >= 2000 &&
        ?year <= 2020
    )
}
GROUP BY ?pays
ORDER BY DESC(?nb_seismes)

# Quelles catastrophes ont eu lieu un vendredi 13 (pas de chance)

PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX db: <http://dbpedia.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX dbo: <http://dbpedia.org/ontology/>
SELECT ?disaster ?name ?date
WHERE {
  ?disaster a dbo:Disaster ;
  dbo:date ?date ;
  dbo:day ?day
  
  OPTIONAL { ?disaster rdfs:label ?name . }
  
  FILTER(?day = 13)
  # 13 avril 1900 = vendredi
  BIND("1900-04-13"^^xsd:date as ?friday)
  #ecart entre premier vendredi et date de la catastrophe
  BIND(DAY(?date - ?friday) AS ?diff)
  # si mod = 0, c'est un vendredi 13
  FILTER((?diff - (FLOOR(?diff / 7) * 7)) = 0)
}
ORDER BY DESC(?date)

# Nombre de morts dus à des catastrophes vs accidents sur les 20 dernieres années du dataset:
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX schema:  <http://schema.org/>
PREFIX ex: <http://example.org/crash/property/>
PREFIX dbo:     <http://dbpedia.org/ontology/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?annee
       (SUM(IF(?categorie = "Disaster", ?morts, 0)) AS ?totalDisasters)
       (SUM(IF(?categorie = "Accident", ?morts, 0)) AS ?totalAccidents)
WHERE {
  {
    ?e a dbo:Disaster ;
       dbo:deathToll ?morts ;
       dbo:date ?d .
    BIND("Disaster" AS ?categorie)
    BIND(YEAR(?d) AS ?annee)
  }
  UNION
  {
    ?e a schema:Event ;
       dcterms:date ?d ;
       ex:passengersFatalities|ex:groundFatalities ?morts .
    BIND("Accident" AS ?categorie)
    BIND(YEAR(?d) AS ?annee)
  }
    FILTER(?annee <= 2009 && ?annee >= 1908) # dataset accident s'arrete à 2009
}
GROUP BY ?annee
ORDER BY DESC(?annee)
LIMIT 20

# Pour chaque continent, quel type de catastrophe a fait le plus de morts,
# et quelle part des morts du continent cela représente-t-il ?

PREFIX dbo: <http://dbpedia.org/ontology/>

SELECT ?continent ?type_le_plus_meurtrier ?morts ?total_continent ?pourcentage
WHERE {
  # 1) total des morts par continent et par type
  {
    SELECT ?continent ?type_le_plus_meurtrier (SUM(?d) AS ?morts)
    WHERE {
      ?e a dbo:Disaster ;
         dbo:continent ?continent ;
         dbo:type ?type_le_plus_meurtrier ;
         dbo:deathToll ?d .
    }
    GROUP BY ?continent ?type_le_plus_meurtrier
  }

  # 2) le maximum de ces totaux pour chaque continent
  {
    SELECT ?continent (MAX(?t) AS ?morts)
    WHERE {
      {
        SELECT ?continent ?type (SUM(?d) AS ?t)
        WHERE {
          ?e a dbo:Disaster ;
             dbo:continent ?continent ;
             dbo:type ?type ;
             dbo:deathToll ?d .
        }
        GROUP BY ?continent ?type
      }
    }
    GROUP BY ?continent
  }

  # 3) total des morts du continent, tous types confondus
  {
    SELECT ?continent (SUM(?d) AS ?total_continent)
    WHERE {
      ?e a dbo:Disaster ;
         dbo:continent ?continent ;
         dbo:deathToll ?d .
    }
    GROUP BY ?continent
  }

  BIND(ROUND(100 * ?morts / ?total_continent) AS ?pourcentage)
}
ORDER BY DESC(?morts)

# Pour Chaque pays qu'elle est la catastrophe naturelle qui leurs coute le plus d'argent

PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?country ?type ?totalDamage
WHERE {
    {
        SELECT ?country ?type (SUM(?damage) AS ?totalDamage)
        WHERE {
            ?disaster a dbo:Disaster ;
                      dbo:country ?country ;
                      dbo:type ?type ;
                      dbo:damage ?damage .
        }
        GROUP BY ?country ?type
    }

    {
        SELECT ?country (MAX(?damageByType) AS ?maxDamage)
        WHERE {
            {
                SELECT ?country ?type (SUM(?damage) AS ?damageByType)
                WHERE {
                    ?disaster a dbo:Disaster ;
                              dbo:country ?country ;
                              dbo:type ?type ;
                              dbo:damage ?damage .
                }
                GROUP BY ?country ?type
            }
        }
        GROUP BY ?country
    }

    FILTER(?totalDamage = ?maxDamage)
}
ORDER BY DESC(?totalDamage)
